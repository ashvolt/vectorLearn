{
  "$defs": {
    "Check": {
      "description": "A gate item. A node turns green when these pass, not when it is read.",
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "recall",
            "predict",
            "code",
            "explain"
          ],
          "title": "Kind",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "grading_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Grading Criteria",
          "type": "array"
        },
        "source_spans": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Spans",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "kind",
        "prompt",
        "answer",
        "grading_criteria",
        "source_spans"
      ],
      "title": "Check",
      "type": "object"
    },
    "Edge": {
      "properties": {
        "src": {
          "title": "Src",
          "type": "string"
        },
        "dst": {
          "title": "Dst",
          "type": "string"
        },
        "origin": {
          "enum": [
            "xref",
            "inferred",
            "manual"
          ],
          "title": "Origin",
          "type": "string"
        },
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        }
      },
      "required": [
        "src",
        "dst",
        "origin"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Environment": {
      "description": "Which surface the workspace mounts for this node.",
      "properties": {
        "kind": {
          "default": "none",
          "enum": [
            "python",
            "javascript",
            "sql",
            "shell",
            "none"
          ],
          "title": "Kind",
          "type": "string"
        },
        "setup": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Setup"
        }
      },
      "title": "Environment",
      "type": "object"
    },
    "Node": {
      "description": "A topic: one box on the map, one gate, N steps.",
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "objective": {
          "title": "Objective",
          "type": "string"
        },
        "zone": {
          "title": "Zone",
          "type": "string"
        },
        "prereqs": {
          "items": {
            "type": "string"
          },
          "title": "Prereqs",
          "type": "array"
        },
        "source_spans": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Spans",
          "type": "array"
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "title": "Steps",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/Check"
          },
          "title": "Checks",
          "type": "array"
        },
        "generated_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated By"
        }
      },
      "required": [
        "node_id",
        "title",
        "objective",
        "zone",
        "source_spans"
      ],
      "title": "Node",
      "type": "object"
    },
    "Step": {
      "description": "One teaching beat. The unit of a daily session.",
      "properties": {
        "step_id": {
          "title": "Step Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "concept",
            "definition",
            "worked_example",
            "predict",
            "code_write",
            "pitfall"
          ],
          "title": "Type",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "body": {
          "title": "Body",
          "type": "string"
        },
        "source_spans": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Spans",
          "type": "array"
        },
        "est_seconds": {
          "maximum": 900,
          "minimum": 15,
          "title": "Est Seconds",
          "type": "integer"
        },
        "reveal": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reveal"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        },
        "starter_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Starter Code"
        },
        "test_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Code"
        }
      },
      "required": [
        "step_id",
        "type",
        "title",
        "body",
        "source_spans",
        "est_seconds"
      ],
      "title": "Step",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "course_id": {
      "title": "Course Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "source_hash": {
      "title": "Source Hash",
      "type": "string"
    },
    "zones": {
      "items": {
        "type": "string"
      },
      "title": "Zones",
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "title": "Edges",
      "type": "array"
    }
  },
  "required": [
    "course_id",
    "title",
    "source_hash"
  ],
  "title": "Course",
  "type": "object"
}
